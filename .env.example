# ---- Shared ----
NODE_ENV=development
# ---- API (apps/api) ----
PORT=4000
# DATABASE_URL=postgresql://medlab:CHANGE_ME@localhost:5432/medlab?schema=public
DATABASE_URL=postgresql://medlab:CHANGE_ME@localhost:5432/medlab?schema=public
# Neon: DATABASE_URL = pooled connection string, DIRECT_URL = direct (non-pooled) string for migrations
# DIRECT_URL=postgresql://medlab:CHANGE_ME@localhost:5432/medlab?schema=public
DIRECT_URL=postgresql://medlab:CHANGE_ME@localhost:5432/medlab?schema=public

JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE_MIN_32_CHARS
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_VALUE_MIN_32_CHARS
ML_TIMEOUT_MS=5000
# Email (password reset). Leave blank in dev to log reset links to the server console (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.invalid
# Demo seeding is refused when NODE_ENV=production.
# ---- Web (apps/web) ----
API_BASE_URL=http://localhost:4000/api/v1
