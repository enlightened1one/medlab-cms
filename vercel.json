{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "installCommand": "pnpm install --frozen-lockfile --filter @medlab/api... --node-linker hoisted",
      "buildCommand": "pnpm exec prisma generate --schema prisma/schema.prisma && pnpm --filter @medlab/shared-types build && pnpm exec nest build",
      "functions": {
        "src/main.ts": {
          "includeFiles": "node_modules/**/*"
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "ml-service",
          "format": "url",
          "env": "ML_SERVICE_URL"
        }
      ]
    },
    "ml-service": {
      "root": "apps/ml-service",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile --filter @medlab/web...",
      "buildCommand": "pnpm --filter @medlab/shared-types build && pnpm --filter @medlab/web build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
